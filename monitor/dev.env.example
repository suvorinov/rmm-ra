# Пример окружения для запуска без Docker (локальная разработка).
#   cp monitor/dev.env.example monitor/dev.env
#   make monitor-dev
#
# НЕ пиши сюда реальные пароли: файл заявлен в .gitignore, но легко скопировать
# куда не надо. Для боевого MeshCentral используй monitor/monitor.env.
#
# Планировщик выключен: интерфейс и API работают без доступа к MeshCentral.
# Убери MON_SCHEDULER_ENABLED=false или запусти с MONITOR_DEV_ARGS="" (без
# --no-scheduler), чтобы проверять живой опрос хостов.

MON_MC_URL=ws://meshcentral:443
MON_MC_USER=dev-placeholder
MON_MC_PASS=dev-placeholder
MON_AUTH_USER=dev
MON_AUTH_PASS=dev
MON_ALLOW_ANONYMOUS=false
MON_SCHEDULER_ENABLED=false
# Явно разрешённые Origin для POST-форм. Нужно, если браузер заходит не под тем
# адресом, который попадает в Host (например, через другое имя или прокси).
# MON_ALLOWED_ORIGINS=http://192.168.0.9:8000,http://127.0.0.1:8000

MON_DB_PATH=/data/monitor.db
MON_HOME=/tmp/monitor-home
MON_MESHCTRL=/opt/meshctrl/meshctrl.js

MON_TZ=Europe/Moscow
MON_TITLE=RMM Monitor (dev)
MON_LOG_LEVEL=INFO
