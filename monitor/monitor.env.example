# Скопируй в monitor/monitor.env и поставь права 600:
#   cp monitor/monitor.env.example monitor/monitor.env
#   chmod 600 monitor/monitor.env
#
# Этот файл — секрет: пароль сервисного аккаунта MeshCentral и пароль
# к веб-интерфейсу. В git он не попадает.

# --- MeshCentral -----------------------------------------------------------
# Внутри docker-сети MeshCentral слушает обычный HTTP на 443 (tlsOffload).
MON_MC_URL=ws://meshcentral:443
# Отдельный сервисный аккаунт MeshCentral с доступом к группам устройств.
# Не используй личный админский аккаунт и не включай ему 2FA без нужды.
MON_MC_USER=svc-monitor
MON_MC_PASS=replace-me

# Если у сервисного аккаунта включена 2FA — сюда одноразовый код.
# MON_MC_TOKEN=

# Логин-ключ MeshCentral можно передать прямо в URL (тогда MON_MC_PASS не нужен):
# MON_MC_URL=ws://meshcentral:443?key=xxxxxxxx

# --- Веб-интерфейс ---------------------------------------------------------
MON_AUTH_USER=admin
MON_AUTH_PASS=replace-me-too
MON_ALLOW_ANONYMOUS=false

# --- Расписание и хранение -------------------------------------------------
# Инвентарь (online/offline, список устройств) — раз в минуту.
MON_INVENTORY_INTERVAL=60
# Снимок нагрузки/процессов/браузеров — раз в 5 минут.
MON_SNAPSHOT_INTERVAL=300
MON_SNAPSHOT_CONCURRENCY=4
MON_SNAPSHOT_TIMEOUT=90
MON_SNAPSHOT_TOP_PROCESSES=25
# 0 = все онлайн-хосты; можно ограничить для первого запуска.
MON_SNAPSHOT_MAX_HOSTS=0
MON_RETENTION_DAYS=30
MON_RETENTION_RUNS_DAYS=30

MON_DB_PATH=/data/monitor.db
MON_TZ=Europe/Moscow
MON_TITLE=RMM Monitor
MON_LOG_LEVEL=INFO
